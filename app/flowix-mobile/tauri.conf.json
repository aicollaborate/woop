{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowix Mobile",
  "version": "1.1.10",
  "identifier": "com.flowix.app.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:mobile -- --port 1421",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": {
      "script": "npm run build:mobile",
      "cwd": "../.."
    },
    "frontendDist": "../../.build/web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flowix",
        "width": 430,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../flowix-desktop/icons/32x32.png",
      "../flowix-desktop/icons/128x128.png",
      "../flowix-desktop/icons/128x128@2x.png",
      "../flowix-desktop/icons/icon.icns",
      "../flowix-desktop/icons/icon.ico"
    ]
  }
}
