#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

if [[ "${1:-}" == "dlx" && "${2:-}" == "@yao-pkg/pkg@6.21.0" ]]; then
  shift 2
  exec "$REPO_ROOT/node_modules/.bin/pkg" "$@"
fi

exec corepack pnpm@11.7.0 "$@"
