+  private hasPersistedSession(sessionId: string): Promise<boolean> | undefined {
+    const persistence = this.ctx.get('sessionPersistence') as {
+      list?: () => Promise<readonly { id: unknown }[]>
+    } | undefined
+    if (persistence === undefined || typeof persistence.list !== 'function') return undefined
+    return persistence.list().then(sessions => sessions.some(session => String(session.id) === sessionId))
+  }
