{
  "name": "flowix",
  "private": true,
  "version": "1.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode mobile",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile",
    "clean": "rm -rf .build dist app/target app/flowix-desktop/binaries",
    "test": "vitest run",
    "check:layers": "node scripts/check-layer-boundaries.mjs",
    "check:mobile-boundaries": "node scripts/check-mobile-boundaries.mjs",
    "check:frontend-debt": "node scripts/check-frontend-debt.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "cli:build": "bash scripts/build-cli.sh",
    "cli:build:debug": "bash scripts/build-cli.sh --debug",
    "cli:build:all": "bash scripts/build-cli.sh --all",
    "cli:build:macos": "bash scripts/build-cli.sh --macos",
    "tauri:dev": "tauri dev --config app/flowix-desktop/tauri.conf.dev.json",
    "tauri:dev:win": "tauri dev --config app/flowix-desktop/tauri.windows.dev.conf.json",
    "tauri:mobile:dev": "npm run tauri:mobile:preview",
    "tauri:mobile:preview": "cd app/flowix-mobile && ../../node_modules/.bin/tauri dev",
    "tauri:mobile:build": "cd app/flowix-mobile && ../../node_modules/.bin/tauri build",
    "tauri:android:init": "cd app/flowix-mobile && ../../node_modules/.bin/tauri android init",
    "tauri:android:dev": "cd app/flowix-mobile && ../../node_modules/.bin/tauri android dev",
    "tauri:android:build": "cd app/flowix-mobile && ../../node_modules/.bin/tauri android build",
    "tauri:ios:init": "cd app/flowix-mobile && ../../node_modules/.bin/tauri ios init",
    "tauri:ios:dev": "cd app/flowix-mobile && ../../node_modules/.bin/tauri ios init --ci --skip-targets-install && cd ../.. && node scripts/patch-ios-native.mjs && cd app/flowix-mobile && ../../node_modules/.bin/tauri ios dev",
    "tauri:ios:build": "cd app/flowix-mobile && ../../node_modules/.bin/tauri ios init --ci --skip-targets-install && cd ../.. && node scripts/patch-ios-native.mjs && cd app/flowix-mobile && ../../node_modules/.bin/tauri ios build",
    "tauri:ios:build:testflight": "bash scripts/build-and-upload-testflight.sh",
    "tauri:build": "tauri build",
    "tauri:build:win": "node scripts/build-tauri-production.mjs --platform win32",
    "tauri:build:mac": "node scripts/build-tauri-production.mjs --platform darwin",
    "tauri:build:production": "node scripts/build-tauri-production.mjs",
    "icons:phosphor:bold": "node scripts/extract-phosphor-bold-paths.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-list": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.14.2",
    "katex": "^0.17.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.15.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "svg-pan-zoom": "^3.6.2",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/svg-pan-zoom": "^3.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "shadcn": "^4.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
